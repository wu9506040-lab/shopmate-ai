# =============================================================
# backend 本地直跑环境变量模板
# -------------------------------------------------------------
# 用法：
#   cp backend/.env.example backend/.env
#   然后按注释把 change_me_* 换成真实值
#
# 与 deploy/.env.example 的区别：
#   deploy/.env.dev  → Docker Compose 全套（服务名寻址，容器内端口）
#   backend/.env     → 本地 uvicorn 直跑（127.0.0.1 + 宿主机映射端口）
# 两者 key 有交集，但连接串不同，不要混用。
# =============================================================

# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---- 数据库 / 缓存 / 向量库 ----
# 宿主机映射端口（compose 里 mysql 映射 3307、redis 6379、milvus 19530）
DATABASE_URL=mysql+pymysql://customer_service:change_me_user_password@127.0.0.1:3307/customer_service?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530

# ---- LLM（DashScope / 通义千问 OpenAI 兼容模式）----
# Key 获取：https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-change_me_qwen_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 主力模型（开放问题作答 / Agent 工具调度）
QWEN_MODEL=qwen-plus
# 意图分类等高频轻量调用，单独配轻量模型，省主模型配额
INTENTION_MODEL=qwen-flash

# ---- Embedding ----
# 留空则回落到 QWEN_API_KEY / DASHSCOPE_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- 鉴权 ----
# 至少 32 字符；生产用 `openssl rand -hex 32` 生成
JWT_SECRET=change_me_at_least_32_chars_random_xxx_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- 接口限流（单 IP 每分钟）----
RATE_LIMIT_PER_MINUTE=60

# =============================================================
# Feature Flags
# 真值三源：config.py 默认值 ← 环境变量 ← 本文件
# 本地想验证某条链路时再打开，默认保持与线上一致
# =============================================================

# Agent 主循环最大工具轮次（防 LLM 死循环 / 成本失控）
MAX_AGENT_TURNS=5

# 全科兜底 Agent（Function Calling）。打开后开放问题走 FC 主循环
ENABLE_AGENT_FC=false
# 双意图双专家协作（次意图补答）
ENABLE_DUAL_INTENT_DISPATCH=false
# 转人工兜底（EscalationService + handoff payload）
ENABLE_ESCALATION_HANDOFF=false
# 订单上下文解析（OrderContextResolver 参与订单决策）
ENABLE_ORDER_RESOLVER=false
# 显式状态机业务流
ENABLE_BUSINESS_FLOW=false
# Multi-Query 检索增强（N 路变体 → RRF 融合）
ENABLE_MULTI_QUERY=false
# Prompt 版本管理（manifest 多版本）
ENABLE_PROMPT_VERSIONING=false
# Demo 访客一键登录（公开演示站用；生产建议 false）
ENABLE_DEMO_LOGIN=true
# 跨会话用户画像（L3 长期记忆）
ENABLE_USER_PROFILE=true
# 用户上下文预加载（最近 5 单 + 画像注入 prompt）
ENABLE_USER_CONTEXT_PRELOAD=true
# conversation_contexts 表读写（L1 工作记忆）
ENABLE_CONTEXT_STORE=true
# SSE meta 事件携带 OrderCard payload
SSE_CARD_V2=true
# 闲鱼 MCP 工具（需额外配 GOOFISH_COOKIE_PATH + goofish-cli）
ENABLE_XIANYU_TOOLS=false
